# This file aggregates all environment variables needed across the workspace

# ==========================================
# BACKEND (.env in /backend)
# ==========================================
PORT=4000
NODE_ENV=development
JWT_SECRET= # E.g., college-bus-tracking-local-dev-secret
ADMIN_EMAIL= # e.g., admin@example.com
ADMIN_PASSWORD_HASH= # bcrypt hash of the admin password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=Asia/Kolkata
COLLEGE_ARRIVAL_DEADLINE=09:50
AI_API_KEY= # Your AI API key for assistant
DATABASE_URL= # Runtime connection string (e.g. Supabase pgbouncer)
DIRECT_URL= # Direct database URL for Prisma migrations
BACKEND_GOOGLE_MAPS_API_KEY= # Backend Google Maps API Key
DATABASE_CONNECTION_LIMIT=5
REQUIRE_RESTRICTED_DB_ROLE=true
EXPECTED_RUNTIME_DB_ROLE=bus_tracker_runtime

# ==========================================
# MOBILE APP (.env in /app)
# ==========================================
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# ==========================================
# ADMIN PANEL (.env in /admin-panel)
# ==========================================
VITE_API_URL=http://localhost:4000/api/v1
